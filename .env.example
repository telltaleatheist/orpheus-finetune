# Copy to .env and fill in. .env is gitignored — it is machine-specific, not repo content.

# Where training runs land: datasets, LoRA adapters, merged models. Needs tens of GB.
# On WSL keep this on the Linux filesystem, not under /mnt/c (the 9p mount is very slow).
ORPHEUS_FT_ROOT=/home/you/xtts_ft

# Only needed for the YouTube title-model scripts (build_titles_dataset.py and friends).
# Expects <root>/source/ and <root>/build/ underneath.
ORPHEUS_TITLES_ROOT=/mnt/e/training/titles
