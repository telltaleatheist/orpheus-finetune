*.wav
*.flac
*.safetensors
*.pth
*.bin
*.ckpt
datasets/
checkpoints/

# machine-specific roots (copy .env.example)
.env

# real session configs are per-machine; sessions/example.json is the template
sessions/*.json
!sessions/example.json

# scratch corpora / probe output
probe_runaway/
