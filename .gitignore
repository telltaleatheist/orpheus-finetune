# Python
__pycache__/
*.pyc
*.pyo

# Unsloth / HF caches that can land in cwd
unsloth_compiled_cache/
.cache/
wandb/
outputs/

# session.py per-run logs (align/cut/train) — useful locally, not repo content
logs/

